# ==============================================================================
# Agentic Task Manager - Backend Environment Template
# ==============================================================================

APP_NAME="Agentic Task Manager"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

FRONTEND_URL=http://localhost:3000

MONGODB_URL=mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agentic_task_manager

JWT_SECRET_KEY=agentic-secret-key-change-in-production-super-secure-token-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=AdminSecurePassword123!
BOOTSTRAP_ADMIN_NAME="System Administrator"

# LLM & Multi-Provider Configuration (LangChain)
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60
LLM_MAX_TOKENS=

TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=


# Privacy & PII Masking Configuration (Microsoft Presidio)
PII_MASKING_ENABLED=true
PII_MASKING_PROVIDER=presidio
PII_MASKING_THRESHOLD=0.5
PII_MASKING_ENTITIES=["PERSON","EMAIL_ADDRESS","PHONE_NUMBER","LOCATION","IP_ADDRESS","URL","CREDIT_CARD","IBAN_CODE","US_SSN","IN_PAN","IN_AADHAAR","IN_PASSPORT"]
