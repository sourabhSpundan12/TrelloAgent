# ==============================================================================
# Agentic Task Manager - Environment Configuration Template
# ==============================================================================

# Application Settings
APP_NAME="Agentic Task Manager"
APP_ENV=development          # development | testing | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Frontend URL (CORS allowed origin)
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000

# MongoDB Configuration
# Local Standalone/Docker MongoDB:
MONGODB_URL=mongodb://localhost:27017
# Or for MongoDB Atlas Cloud:
# MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_URI is supported as a backward-compatible alias for MONGODB_URL
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agentic_task_manager
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_MS=5000

# Security & Authentication (Argon2 + JWT)
# In production, generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=agentic-secret-key-change-in-production-super-secure-token-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Admin Bootstrap (Optional - creates an admin on first startup if configured)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=AdminSecurePassword123!
BOOTSTRAP_ADMIN_NAME="System Administrator"

# Future Integration Placeholders (Not used in Phase 3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_API_KEY=
